{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:config-reconciliation": "node --experimental-strip-types --test tests/config-reconciliation.test.ts",
    "e2e:input-readiness": "playwright test -c playwright.input-readiness.config.ts",
    "test:route-chunks": "node --test tests/route-chunks.test.mjs",
    "verify:route-chunks": "node scripts/verify-route-chunks.mjs",
    "preview": "vite preview",
    "e2e:serve": "npm run build && vite preview --config e2e/vite.closure.config.ts --host 127.0.0.1 --strictPort"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
